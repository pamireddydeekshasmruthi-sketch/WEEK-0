
import java.util.Scanner;

public class EvenPlaces {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a number: ");
        int num = sc.nextInt();

        int position = 1;
        int sum = 0;

        while (num > 0) {
            int digit = num % 10;

            if (position % 2 == 0) {
                sum = sum + digit;
            }

            num = num / 10;
            position++;
        }

        System.out.println("Sum of even places = " + sum);
        sc.close();
    }
}
